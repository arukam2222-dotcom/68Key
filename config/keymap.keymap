#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        LeftMouseClick {
            bindings = <&mkp LCLK>;
            key-positions = <37 38>;
        };

        RightMouseClick {
            bindings = <&mkp RCLK>;
            key-positions = <38 39>;
        };

        MiddleMouseClick {
            bindings = <&none>;
            key-positions = <63 37>;
        };

        MiddleMouseClick2 {
            bindings = <&none>;
            key-positions = <37 54>;
        };

        MouseScroll {
            bindings = <&none>;
            key-positions = <37 38 39>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp ESCAPE  &none  &none  &none  &none  &none  &none  &none
&kp TAB           &kp Q         &kp W         &kp E         &kp R         &kp T         &kp F8      &none  &none  &none  &none  &none  &none  &none
&kp F6            &kp A         &kp S         &kp D         &kp F         &kp G         &kp F7      &none  &none  &none  &none  &none  &none  &none
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V         &none         &none       &none  &none  &none  &none  &none  &none  &none
&kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &kp INT3      &none         &none         &none       &none  &none                &none  &none  &none
            >;
        };

        layer_1 {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none                &none  &none  &none
            >;
        };

        layer_2 {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none                &none  &none  &none
            >;
        };

        layer_3 {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none                &none  &none  &none
            >;
        };
    };
};
