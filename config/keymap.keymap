#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        /* ↓↓ これが tog_off の正体（設計図）です ↓↓ */

        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off"; /* ここが重要！「オフにする専用」の設定 */
        };
    };

    macros {
        MouseLeftMacro: MouseLeftMacro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mkp LCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp LCLK>,
                <&macro_tap>,
                <&tog_off 2 &sl 2>;

            label = "MOUSELEFTMACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp MINUS  &kp EQUAL            &kp NUMBER_6   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0   &kp BACKSPACE
&kp ESCAPE        &kp Q         &kp W         &kp E         &kp R         &kp T         &mo 1      &kp LEFT_BRACKET     &kp Y          &kp U         &kp I         &kp O         &kp P          &kp RIGHT_BRACKET
&kp TAB           &kp A         &kp S         &kp D         &kp F         &kp G         &mo 2      &kp SQT              &kp H          &kp J         &kp K         &kp L         &kp SEMICOLON  &kp ENTER
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V         &kp B         &mo 3      &kp INTERNATIONAL_1  &kp N          &kp M         &kp COMMA     &kp PERIOD    &kp SLASH      &kp ENTER
&kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &kp INT3      &kp TAB       &kp SPACE     &kp SPACE  &lt 4 ENTER          &kp BACKSPACE                              &kp DELETE    &mo 3          &kp NON_US_HASH
            >;
        };

        layer_1 {
            bindings = <
&kp GRAVE       &none           &none           &none           &none           &none            &none                 &none            &none           &none            &kp KP_SLASH     &kp KP_SLASH     &kp KP_ASTERISK  &kp KP_MINUS
&kp TAB         &kp F2          &kp F6          &kp F7          &kp F8          &kp F10          &kp LA(LC(NUMBER_3))  &none            &none           &none            &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
&none           &none           &kp UP_ARROW    &none           &kp UP_ARROW    &none            &kp LC(LA(N0))        &kp RIGHT_SHIFT  &kp UP_ARROW    &none            &kp KP_N4        &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS
&kp LEFT_SHIFT  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LG(PERIOD)        &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp KP_N1        &kp KP_N2        &kp KP_NUMBER_3  &kp KP_ENTER
&kp LCTRL       &kp LEFT_GUI    &kp LEFT_ALT    &kp ENTER       &none           &kp SPACE        &none                 &kp ENTER        &kp BACKSPACE                                     &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_ENTER
            >;
        };

        layer_2 {
            bindings = <
&none           &none  &none  &none      &none     &none   &none   &none   &none     &none      &none      &none  &none  &none
&kp TAB         &none  &none  &none      &none     &none   &none   &none   &none     &none      &none      &none  &none  &none
&none           &none  &none  &mkp RCLK  &mkp MB1  &none   &none   &none   &none     &mkp LCLK  &mkp RCLK  &none  &none  &none
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C      &kp V     &none   &trans  &none   &mkp MB4  &none      &none      &none  &none  &none
&kp LCTRL       &none  &none  &none      &trans    &trans  &trans  &trans  &trans                          &none  &none  &none
            >;
        };

        layer_3 {
            bindings = <
&none           &none   &none   &none   &none   &none  &none  &none      &none                     &none           &kp KP_SLASH    &kp KP_SLASH     &kp KP_MULTIPLY  &kp KP_MINUS
&none           &none   &none   &none   &none   &none  &none  &none      &none                     &none           &kp KP_N7       &kp KP_N8        &kp KP_N9        &kp KP_PLUS
&none           &none   &none   &none   &none   &none  &none  &none      &none                     &none           &kp UP_ARROW    &kp KP_N5        &kp KP_N6        &kp KP_PLUS
&kp LEFT_SHIFT  &trans  &trans  &trans  &trans  &none  &none  &none      &none                     &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp KP_NUMBER_3  &kp KP_ENTER
&kp LCTRL       &none   &none   &none   &none   &none  &none  &kp ENTER  &mt LEFT_SHIFT BACKSPACE                                  &kp KP_N0        &none            &kp KP_ENTER
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_SLASH  &kp KP_SLASH  &kp KP_MULTIPLY  &kp KP_MINUS
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_N7     &kp KP_N8     &kp KP_N9        &kp KP_PLUS
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_N4     &kp KP_N5     &kp KP_N6        &kp KP_PLUS
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_N1     &kp KP_N2     &kp KP_N3        &kp KP_ENTER
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                        &kp KP_N0     &kp KP_DOT       &kp KP_ENTER
            >;
        };

        layer_bt {
            bindings = <
&trans  &trans  &trans  &trans  &trans      &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &bt BT_CLR  &bt BT_SEL 0  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans      &bt BT_SEL 1  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans      &bt BT_SEL 2  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans      &trans        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
    };
};
