#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        LeftMouseClick {
            bindings = <&mkp LCLK>;
            key-positions = <51 50>;
        };

        RightMouseClick {
            bindings = <&mkp RCLK>;
            key-positions = <52 51>;
        };

        MiddleMouseClick {
            bindings = <&mkp MCLK>;
            key-positions = <36 37>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp ESCAPE  &kp EQUAL        &kp NUMBER_6   &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0   &kp MINUS
&kp TAB           &kp Q         &kp W         &kp E         &kp R         &kp T         &kp F8      &kp RIGHT_BRACE  &kp Y          &kp U         &kp I         &kp O         &kp P          &kp LEFT_BRACE
&kp F6            &kp A         &kp S         &kp D         &kp F         &kp G         &kp F7      &kp NON_US_HASH  &kp H          &kp J         &kp K         &kp L         &kp SEMICOLON  &kp APOSTROPHE
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C         &kp V         &kp B         &mo 2       &kp B            &kp N          &kp M         &kp COMMA     &kp PERIOD    &kp SLASH      &kp INTERNATIONAL_1
&kp LEFT_CONTROL  &kp LEFT_GUI  &kp LEFT_ALT  &kp INT3      &kp F10       &kp SPACE     &mo 1       &kp RET          &kp BACKSPACE                              &kp DELETE    &mo 2          &kp RIGHT_SHIFT
            >;
        };

        layer_1 {
            bindings = <
&kp GRAVE       &none         &none           &none           &none            &none      &none   &none            &none          &none  &kp KP_SLASH     &kp KP_SLASH     &kp STAR         &kp KP_MINUS
&kp TAB         &none         &none           &none           &none            &none      &none   &none            &none          &none  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS
&none           &none         &none           &kp UP_ARROW    &none            &none      &none   &kp RIGHT_SHIFT  &none          &none  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS
&kp LEFT_SHIFT  &none         &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none      &kp F2  &none            &none          &none  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ENTER
&kp LCTRL       &kp LEFT_GUI  &kp LEFT_ALT    &kp F5          &none            &kp SPACE  &none   &kp ENTER        &kp BACKSPACE                          &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_ENTER
            >;
        };

        layer_2 {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none             &none             &none            &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none             &none             &none            &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none             &msc MOVE_Y(15)   &kp RG(PERIOD)   &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &msc MOVE_X(-15)  &msc MOVE_Y(-15)  &msc MOVE_X(15)  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none                                                &none  &none  &none
            >;
        };

        layer_3 {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none                &none  &none  &none
            >;
        };
    };
};
